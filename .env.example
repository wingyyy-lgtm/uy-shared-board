# Required
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
# Shared password for the whole site (HTTP Basic, any username). Required in production.
ACCESS_CODE=
# Optional
DEEPSEEK_MODEL=deepseek-chat
QWEN_MODEL=qwen-plus
# Python interpreter used to extract PDF text (pypdf). Defaults to python3;
# set it to a specific interpreter if that one is not on PATH.
PDF_PYTHON_BIN=
